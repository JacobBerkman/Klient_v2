node_modules/
.npm-cache/

# Local environment (contains secrets) — never commit
.env
.env.local
.env.*.local

# Runtime data: SQLite DB, WAL files, local object storage, backups
data/*
!data/.gitkeep

# Transient per-run gate evidence (finalized release bundles in
# artifacts/release-evidence/<release-id>/ are committed intentionally)
artifacts/release-evidence/*.json
artifacts/release-evidence/*.txt
artifacts/main-parity.json

# Test output
playwright-report/
test-results/

# TypeScript incremental build cache
apps/web/*.tsbuildinfo

# Built web assets: generated by `npm run web:build` (locally, in CI, and
# inside the Docker image build) — never committed
apps/web/dist/

# Caddy TLS runtime state (when running the optional `tls` compose profile
# with bind mounts instead of named volumes)
deploy/caddy_data/
deploy/caddy_config/
