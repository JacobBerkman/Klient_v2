PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info
SERVICE_NAME=kinetic-klient-api
INSTANCE_ID=local-dev
ENABLE_DEMO_MODE=false

# Required in production for ops token auth on /api/ops/diagnostics and /api/ops/exports/queue.
# Set at least one token source; each token must be at least 24 characters.
KLIENT_OPS_TOKEN_ACTIVE=replace-with-24-plus-char-ops-token-active
# KLIENT_OPS_TOKEN_PREVIOUS=replace-with-24-plus-char-ops-token-previous
# KLIENT_OPS_TOKENS=token-a,token-b
# Legacy single-token fallback (still accepted):
KLIENT_OPS_TOKEN=replace-with-24-plus-char-ops-token

# Auth provider mode (required in production): local | oidc | saml
AUTH_PROVIDER=local

# OIDC mode (required when AUTH_PROVIDER=oidc)
# Reserved for future federated auth; not yet implemented.
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret-min-16-chars
# OIDC_REDIRECT_URI=https://app.example.com/auth/callback
# OIDC_ALLOWED_ALGS=RS256

# SAML mode (required when AUTH_PROVIDER=saml)
# Reserved for future federated auth; not yet implemented.
# SAML_ENTRY_POINT=https://idp.example.com/saml/sso
# SAML_ISSUER=kinetic-klient
# SAML_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
# SAML_CLOCK_SKEW_SECONDS=120

# PII key provider mode: env | kms
PII_KEY_PROVIDER=env

# Env mode (required when PII_KEY_PROVIDER=env)
PII_ACTIVE_KEY_ID=app-key-v1
PII_KEYRING={"app-key-v1":"plain:replace-with-32-byte-base64-or-hex-key"}

# KMS mode (required when PII_KEY_PROVIDER=kms)
# PII_KMS_KEY_ALIAS=pii-master
# PII_KMS_ACTIVE_KEY_ID=kms-key-v1
# PII_KMS_KEYRING={"kms-key-v1":"plain:base-key-material-v1"}

# Object storage provider config
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/objects
STORAGE_BUCKET_DOCUMENTS=klient-documents
STORAGE_BUCKET_EXPORTS=klient-exports

# Required when STORAGE_PROVIDER=s3 (works with AWS S3 or MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Lifecycle policy tuning
STORAGE_EXPORT_TTL_DAYS=14
STORAGE_EXPORT_ARCHIVE_AFTER_DAYS=3
STORAGE_EXPORT_PURGE_AFTER_DAYS=30
STORAGE_UPLOAD_TTL_DAYS=365
STORAGE_UPLOAD_ARCHIVE_AFTER_DAYS=90
STORAGE_UPLOAD_PURGE_AFTER_DAYS=730

# Companion export worker tuning. The API enqueues exports; this process drains them.
EXPORT_WORKER_ID=local-export-worker
EXPORT_WORKER_POLL_MS=500
EXPORT_WORKER_LEASE_MS=15000
EXPORT_WORKER_BATCH_SIZE=5
